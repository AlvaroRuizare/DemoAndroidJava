<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".View.Listado">

    <!-- Fila búsqueda y menu -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Campo búsqueda-->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/tilBusqueda"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/strContrasena"
            android:padding="5dp"
            app:startIconDrawable="@drawable/search"
            app:startIconTint="@color/md_theme_tertiary"
            android:layout_weight="1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/tietBusqueda"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="text"
                />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Imagen clicable menú -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/sivMenu"
            android:layout_width="50dp"
            android:layout_height="wrap_content"
            android:src="@drawable/dots"
            android:tint="@color/md_theme_tertiary"
            android:paddingEnd="5dp">

        </com.google.android.material.imageview.ShapeableImageView>
    </LinearLayout>


    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tlListado"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        app:tabIndicatorColor="@color/md_theme_tertiary"
        app:tabSelectedTextColor="@color/md_theme_tertiary"
        app:tabTextColor="@color/md_theme_primary" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/vp2Apartados"
        android:layout_width="match_parent"
        android:layout_height="match_parent"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvUsuarios"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"/>

</LinearLayout>